{
  "name": "@dodgeball/web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Vite shell for the Rust Bevy dodgeball client",
  "scripts": {
    "dev": "bash -c 'test -f src/wasm/dodgeball_client.js || pnpm wasm' && vite",
    "pretypecheck": "bash -c 'test -f src/wasm/dodgeball_client.js || pnpm wasm'",
    "wasm": "bash ../../scripts/build-web-wasm.sh",
    "build": "pnpm wasm && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
