{
  "name": "dodgeball-simulator",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @dodgeball/web dev",
    "build": "pnpm --filter @dodgeball/web build",
    "preview": "pnpm --filter @dodgeball/web preview",
    "typecheck": "pnpm --filter @dodgeball/web typecheck",
    "rust:check": "cargo check --manifest-path Cargo.toml",
    "rust:check:wasm": "cargo check --manifest-path Cargo.toml --target wasm32-unknown-unknown",
    "rust:test": "cargo test --manifest-path Cargo.toml",
    "rust:fmt": "cargo fmt --manifest-path Cargo.toml --all",
    "check": "pnpm typecheck && pnpm rust:test && pnpm rust:check:wasm"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20"
  }
}
